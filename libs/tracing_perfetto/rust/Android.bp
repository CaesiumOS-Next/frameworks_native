// Inherits default_applicable_licenses from the frameworks_native_license
// package declaration further up the tree.

// Generate the C++ side of the cxx bridge declared in lib.rs.
genrule {
    name: "libtracing_perfetto_rust_bridge_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) >> $(out)",
    srcs: ["lib.rs"],
    out: ["tracing_perfetto_cxx_generated.cc"],
}

// Compile the generated bridge code against the headers exported by
// libtracing_perfetto (which re-exports the libperfetto_c headers).
cc_library_static {
    name: "libtracing_perfetto_rust_bridge",
    host_supported: true,
    generated_headers: ["cxx-bridge-header"],
    generated_sources: ["libtracing_perfetto_rust_bridge_code"],
    shared_libs: ["libtracing_perfetto"],
}

rust_defaults {
    name: "libtracing_perfetto_rust_defaults",
    crate_name: "tracing_perfetto",
    srcs: ["lib.rs"],
    edition: "2021",
    host_supported: true,
    rustlibs: ["libcxx"],
    static_libs: ["libtracing_perfetto_rust_bridge"],
    shared_libs: ["libtracing_perfetto"],
}

rust_library {
    name: "libtracing_perfetto_rust",
    defaults: ["libtracing_perfetto_rust_defaults"],
}

rust_test {
    name: "libtracing_perfetto_rust_test",
    defaults: ["libtracing_perfetto_rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: ["general-tests"],
}
